# Copia este archivo como .env.local y pon las claves de tu proyecto.
# Sin él, la app corre con los datos de ejemplo.
#
# Las dos salen de Supabase → Project Settings → API.
# La publishable key es pública por diseño: lo que protege los datos son las
# políticas RLS del schema.sql, no esta clave.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clave pública VAPID para las notificaciones push.
# Se genera con: node -e "console.log(require('web-push').generateVAPIDKeys())"
# La PRIVADA nunca va aquí: vive solo en las variables del servidor.
VITE_VAPID_PUBLIC_KEY=
